rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null ? u.data : {};
    }
    function getUserRole() {
      return isSignedIn() ? getUserData().get('role', null) : null;
    }
    function getGlobalRole() {
      return isSignedIn() ? getUserData().get('globalRole', null) : null;
    }
    function tokenGlobalRole() {
      return isSignedIn() ? request.auth.token.globalRole : null;
    }
    function userDepartment() {
      return isSignedIn() ? getUserData().get('department', null) : null;
    }
    function userDepartments() {
      return isSignedIn() ? getUserData().get('departments', []) : [];
    }
    function isFullAccess() {
      // Super admin override (prioritize Auth custom claim), with legacy fallback.
      return isSignedIn() && (
        tokenGlobalRole() == 'FOUNDER' ||
        getGlobalRole() == 'FOUNDER' ||
        getUserRole() == 'Founder' ||
        getUserRole() == 'founder'
      );
    }
    function canAccessDept(departmentId) {
      return isSignedIn() && (
        isFullAccess() ||
        userDepartment() == departmentId ||
        (departmentId in userDepartments())
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (isFullAccess() || request.auth.uid == userId);
    }

    // Audit logs: everyone may write; only Founder may read
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && isFullAccess();
      allow update, delete: if false;
    }

    // Department assignments (e.g. D Light Assign tab)
    match /department_assignments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isFullAccess();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      // Caring creates cross-department referral tasks (e.g. "Notify Cell" to add someone to a
      // cell group, "Forward to D-Light" to register a visitor) targeting a department Caring
      // itself doesn't have access to — pcsReferral flags those as a recognized referral, same
      // carve-out shape as the existing cellMemberReferral one below.
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department) || request.resource.data.cellMemberReferral == true || (request.resource.data.pcsReferral == true && canAccessDept('Caring')));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_team_members/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department) || canAccessDept('Caring'));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    // Church member profiles (baptism, marriage, leadership history) — Caring holds highest authority
    // Cell leaders may write only when a Caring Director has sent a profile-fill invitation
    // (active write grants are tracked in pcs_profile_grants/{visitorId})
    match /member_profiles/{visitorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isFullAccess() ||
        canAccessDept('Caring') ||
        (canAccessDept('Cell') &&
         visitorId != '' &&
         exists(/databases/$(database)/documents/pcs_profile_grants/$(visitorId)) &&
         get(/databases/$(database)/documents/pcs_profile_grants/$(visitorId)).data.cellId == userLinkedCellId())
      );
    }

    // Write-grant tokens: Caring creates on invitation send, Cell deletes after filling
    match /pcs_profile_grants/{visitorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
    }

    match /department_sub_departments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_children/{docId} {
      // Sunday Ministry additionally reads River Kids' children for the Sunday School
      // attendee search in Live Control (Non Cell / Others linking, River Kids registry).
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department) || (resource.data.department == 'River Kids' && canAccessDept('Sunday Ministry')));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_child_attendance/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_events/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    // Event spending table for Event Management → Spending (read/write to authorized department users)
    match /event_spending/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_planning_notes/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_updates/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_entries/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /delight_visitors/{docId} {
      // Sunday Ministry reads for Non Cell / Others attendance search-linking (Live Control).
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('D Light') || canAccessDept('Caring') || canAccessDept('Sunday Ministry'));
      allow create, delete: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('D Light') || canAccessDept('Caring'));
    }

    match /dlight_sub_departments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
    }

    match /dlight_members/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || getUserRole() == 'Admin' || canAccessDept('D Light'));
    }

    match /sunday_program/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    match /sunday_program_log/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    match /cell_groups/{cellId} {
      // Sunday Ministry and Caring need read access (attendance + PCS cell connections).
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Sunday Ministry') || canAccessDept('Caring'));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
    }

    match /cell_groups/{cellId}/members/{memberId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Sunday Ministry') || canAccessDept('Caring'));
      // Write is restricted: Founder/Admin full access; Cell Director can write any cell;
      // Cell Leader can only write members within their own linked cell.
      allow create, update, delete: if isSignedIn() && (
        isFullAccess() ||
        isCellDirector() ||
        (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId))
      );
    }
    match /cell_groups/{cellId}/program_items/{itemId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
      allow create, update, delete: if isSignedIn() && (isFullAccess() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
    }
    match /cell_program_log/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cell_back_to_bible/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cell_member_pending_changes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Prefer cellGroupId when set; otherwise cellId (leader's linked cell for report edits).
    function userLinkedCellId() {
      let d = getUserData();
      let g = d.get('cellGroupId', null);
      return g != null && g != '' ? g : d.get('cellId', null);
    }
    // True when the given cell_groups Firestore doc ID matches the user's linked cell.
    // Handles two cases:
    //  1. Profile stores the doc ID directly - exact match.
    //  2. Profile stores a logical cellId string (e.g. "bethany") - look up the
    //     cell_groups doc and compare its cellId field against the profile value.
    function userLinkedCellMatchesDocId(docId) {
      let linked = userLinkedCellId();
      return linked != null && linked != '' && (
        linked == docId ||
        (exists(/databases/$(database)/documents/cell_groups/$(docId)) &&
         get(/databases/$(database)/documents/cell_groups/$(docId)).data.get('cellId', '') == linked)
      );
    }
    // True when the user's `positions` array has an explicit Cell-department Director
    // entry (new `role: 'DIRECTOR'` schema or legacy `position: 'Director'` schema).
    function hasCellDirectorPosition() {
      return isSignedIn() && getUserData().get('positions', []).hasAny([
        {'department': 'Cell', 'role': 'DIRECTOR'},
        {'department': 'Cell', 'position': 'Director'}
      ]);
    }
    function isCellDirector() {
      // Prefer the explicit positions-array check above. Only fall back to the
      // top-level role/department fields for legacy profiles with no positions
      // array at all — otherwise a Director of an unrelated department (e.g. a
      // Cell Leader who is also River Kids Director) whose primary `department`
      // field happens to be 'Cell' would incorrectly gain full Cell Director
      // access to every cell's reports and members.
      return isSignedIn() && (
        hasCellDirectorPosition() ||
        (getUserData().get('positions', []).size() == 0 &&
          getUserRole() == 'Director' &&
          (userDepartment() == 'Cell' || 'Cell' in userDepartments()))
      );
    }
    match /cell_reports/{reportId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow create: if isSignedIn() && (isFullAccess() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(request.resource.data.cellId)));
      allow update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }
    match /cell_reports/{reportId}/attendees/{attendeeId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(get(/databases/$(database)/documents/cell_reports/$(reportId)).data.get('cellId', ''))));
      allow create, update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(get(/databases/$(database)/documents/cell_reports/$(reportId)).data.get('cellId', ''))));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    // Weekly cell report history
    match /cell_report_history/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    match /caring_members/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    match /caring_pcs/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    // Central people registry — Caring is the primary gatekeeper; other depts read for search/linking
    match /people/{personId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('D Light') || isCellDirector());
    }

    // Lightweight PCS membership lookup — any signed-in user can read, Caring writes
    match /pcs_lookup/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    // PCS add notifications: Cell Leader sends → Caring Director receives
    match /pcs_add_notifications/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Visitor proposals: Cell/Caring propose → D-Light Director reviews
    match /cell_visitor_proposals/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Caring'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('D Light') || canAccessDept('Cell') || canAccessDept('Caring'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // PCS profile-fill invitations: Caring Director sends → Cell Leader fills
    match /pcs_fill_invitations/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    match /cell_attendance/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /finance_budget/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || !('department' in resource.data) || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || !('department' in request.resource.data) || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || !('department' in resource.data) || canAccessDept(resource.data.department));
    }

    match /pastor_department_remarks/{docId} {
      allow read, write: if isSignedIn();
    }

    match /pastor_department_updates/{docId} {
      allow read, write: if isSignedIn();
    }

    match /finance_income/{docId} {
      allow read, write: if isSignedIn();
    }

    match /finance_expense/{docId} {
      allow read, write: if isSignedIn();
    }

    match /expense_departments/{docId} {
      allow read, write: if isSignedIn();
    }

    match /attendance/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_plans/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_budget_items/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_team_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_songs/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_schedule/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_ministry_team_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_ministry_budget_items/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_reports/{docId} {
      allow read: if isSignedIn();
      // D Light additionally writes second/third/fourth week comer names onto the report
      // for a given Sunday (Follow-Up panel on the Visitors page) — same cross-department
      // write pattern already used by River Kids for the riverKids field.
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() || canAccessDept('D Light'));
    }

    // Mid-week Ministry: prayer points per cell per date
    match /cell_midweek_prayer/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Mid-week Ministry: segment order settings per cell group
    match /cell_midweek_settings/{cellId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Mid-week session summaries: timings, shepherd notes, attendee IDs per session
    match /cell_midweek_sessions/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    // Sunday service attendance (cell-level bubble grid)
    match /sunday_service_attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || canAccessDept('Cell'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Sunday Plan checklists — defaults (Directors set once)
    match /sunday_checklist_defaults/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
    }

    match /board_meeting_points/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
    }

    match /sec_core/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    match /sec_core_sunday_leader/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    // Sunday Plan checklists — weekly instances
    match /sunday_checklist_weekly/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Sunday programme notifications (Sunday Ministry → departments)
    match /sunday_notifications/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    // Department programme inputs (each dept's elements per Sunday)
    match /sunday_dept_inputs/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() ||
        canAccessDept('Media') || canAccessDept('Worship') || canAccessDept('D Light') || canAccessDept('Administration'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() ||
        canAccessDept('Media') || canAccessDept('Worship') || canAccessDept('D Light') || canAccessDept('Administration'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
    }

    // Collection-group query support: allows collectionGroup(db, 'members') used by getAllCellGroupMembers()
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Sunday Ministry') || canAccessDept('Caring'));
    }
  }
}
