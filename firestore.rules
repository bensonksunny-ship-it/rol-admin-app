rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null ? u.data : {};
    }
    function getUserRole() {
      return isSignedIn() ? getUserData().get('role', null) : null;
    }
    function getGlobalRole() {
      return isSignedIn() ? getUserData().get('globalRole', null) : null;
    }
    function tokenGlobalRole() {
      return isSignedIn() ? request.auth.token.globalRole : null;
    }
    function userDepartment() {
      return isSignedIn() ? getUserData().get('department', null) : null;
    }
    function userDepartments() {
      return isSignedIn() ? getUserData().get('departments', []) : [];
    }
    function userPositions() {
      return isSignedIn() ? getUserData().get('positions', []) : [];
    }
    function isFullAccess() {
      // Super admin override (prioritize Auth custom claim), with legacy fallback.
      return isSignedIn() && (
        tokenGlobalRole() == 'FOUNDER' ||
        getGlobalRole() == 'FOUNDER' ||
        getUserRole() == 'Founder' ||
        getUserRole() == 'founder'
      );
    }
    // Same enumeration approach as hasAnyCellPosition() below, generalized to any
    // department: rules language has no generic "any element has field X" check,
    // so this builds one literal map per position/role value the app actually
    // writes (see AdminUserManagement.jsx's position dropdown) and asks whether
    // `positions[]` contains an exact match for this department.
    function hasAnyPositionInDept(departmentId) {
      return isSignedIn() && userPositions().hasAny([
        {'department': departmentId, 'position': 'Director'},
        {'department': departmentId, 'position': 'Coordinator'},
        {'department': departmentId, 'position': 'Cell Leader'},
        {'department': departmentId, 'position': 'Associate'},
        {'department': departmentId, 'role': 'DIRECTOR'},
        {'department': departmentId, 'role': 'COORDINATOR'},
        {'department': departmentId, 'role': 'LEADER'},
        {'department': departmentId, 'role': 'MEMBER'}
      ]);
    }
    function canAccessDept(departmentId) {
      // `departments[]` is written back to the user doc by the client's own
      // AuthContext sync-on-login effect, so a role just assigned in
      // AdminUserManagement can lag behind until that user's next session load.
      // `positions[]` is the immediate source of truth (same one the client's
      // getDepartmentRole/canManageDepartment check first) — checking it here too
      // means a freshly assigned Director/Coordinator isn't blocked by that lag.
      return isSignedIn() && (
        isFullAccess() ||
        userDepartment() == departmentId ||
        (departmentId in userDepartments()) ||
        hasAnyPositionInDept(departmentId)
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (isFullAccess() || request.auth.uid == userId);
    }

    // Denormalized public directory (name/email/role/department — no phone or
    // membershipNumber) so any signed-in user can search for who to message —
    // see /conversations below. Writable by the owning user, or by Founder
    // (isFullAccess) when backfilling entries for other users.
    match /user_directory/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || request.auth.uid == uid);
    }

    // 1-to-1 direct messages. conversationId is the two participant uids sorted+joined,
    // so membership can be checked directly off the doc without an extra lookup.
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // Per-user "Ignore" state for the notification bell (My Workspace). Doc id is
    // `{uid}_{notificationId}`; only the owning user may read/write their own rows —
    // this never touches the source collections the notifications are synthesized from.
    match /dismissed_notifications/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid);
    }

    // Per-user "already added to To-Do" flag for the notification bell — same shape
    // and ownership rule as dismissed_notifications above, tracked separately (in
    // addition to also dismissing the notification) so the "+ Add to To-Do" button
    // can't create a duplicate task if it fires again before the dismissal lands.
    match /notification_todo_additions/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid);
    }

    // Audit logs: everyone may write; only Founder may read
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && isFullAccess();
      allow update, delete: if false;
    }

    // Department assignments (e.g. D Light Assign tab)
    match /department_assignments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isFullAccess();
    }

    // Founder's personal Worklist Sheet tracker — fully Founder-only, no department scoping.
    match /worklist_sheets/{sheetId} {
      allow read, write: if isFullAccess();
    }

    // Global app settings (e.g. settings/pastoral_roster — default Pastors shown as
    // pre-linked suggestions on every Sunday report). Read by anyone signed in since
    // every Sunday report editor needs it; write restricted to Founder, same governance
    // level as the /departments collection above.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isFullAccess();
    }

    match /tasks/{taskId} {
      // Cell also needs read access to its own cellAssignConsult requests once they've moved
      // to department: 'D Light' — otherwise the Unassigned row status badge can't tell
      // "pending" from "consulted" (see subscribeCellDlightConsultTasks).
      // Caring also needs read access to its own pcsReferral tasks once they've moved to
      // department: 'Cell' — otherwise it can create a referral but never verify/dedupe it,
      // so "Notify Cell Director" looks unsent again on every reload and can be double-fired.
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department) || (resource.data.cellAssignConsult == true && canAccessDept('Cell')) || (resource.data.pcsReferral == true && canAccessDept('Caring')));
      // Caring creates cross-department referral tasks (e.g. "Notify Cell" to add someone to a
      // cell group, "Forward to D-Light" to register a visitor) targeting a department Caring
      // itself doesn't have access to — pcsReferral flags those as a recognized referral, same
      // carve-out shape as the existing cellMemberReferral one below.
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department) || request.resource.data.cellMemberReferral == true || (request.resource.data.pcsReferral == true && canAccessDept('Caring')) || (request.resource.data.cellAssignConsult == true && canAccessDept('Cell')));
      // Cell Director consult requests (department: 'D Light', cellAssignConsult: true) are owned by
      // D Light once created, same handoff shape as pcsReferral above — except the original Cell
      // requester may also close their own request out (status -> 'Completed' only, nothing else)
      // once they've assigned the person, without needing D Light to act first.
      allow update: if isSignedIn() && (
        isFullAccess() ||
        canAccessDept(resource.data.department) ||
        (resource.data.cellAssignConsult == true && canAccessDept('Cell') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      // Delete matches read/update's department scoping — My Workspace's To-Do List
      // lets department users delete their own department's tasks inline, not just Founder/Admin.
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_team_members/{docId} {
      // Read opened to any signed-in user. This is one of the sources merged by
      // getMergedPeopleDirectory() — the roster behind every "search the People's
      // Directory" picker in the app (add someone to a team, to a cell group, to the
      // Director Board, to a Sunday report). getAllDepartmentTeamMembers() reads the
      // whole collection with no `where`, so a per-document department check fails the
      // ENTIRE query for anyone outside that department — and the caller's
      // `.catch(() => [])` swallowed it, so every team member silently vanished from
      // the search results instead of erroring. Names/roles here are not sensitive;
      // writes stay department-scoped below.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    // Church member profiles (baptism, marriage, leadership history) — Caring holds highest authority
    // Cell leaders may write only when a Caring Director has sent a profile-fill invitation
    // (active write grants are tracked in pcs_profile_grants/{visitorId})
    match /member_profiles/{visitorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isFullAccess() ||
        canAccessDept('Caring') ||
        (canAccessDept('Cell') &&
         visitorId != '' &&
         exists(/databases/$(database)/documents/pcs_profile_grants/$(visitorId)) &&
         get(/databases/$(database)/documents/pcs_profile_grants/$(visitorId)).data.cellId == userLinkedCellId())
      );
    }

    // Write-grant tokens: Caring creates on invitation send, Cell deletes after filling
    match /pcs_profile_grants/{visitorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
    }

    match /department_sub_departments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_children/{docId} {
      // Sunday Ministry additionally reads River Kids' children for the Sunday School
      // attendee search in Live Control (Non Cell / Others linking, River Kids registry).
      // Cell additionally reads River Kids' children for the cell-report "Kids Present"
      // picker, which name-matches a child's fatherName/motherName against the active
      // cell's member roster (department_children has no parentId/cellGroupId field).
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department) || (resource.data.department == 'River Kids' && (canAccessDept('Sunday Ministry') || canAccessDept('Cell') || hasAnyCellPosition())));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_child_attendance/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    // Name-only index of active River Kids children (doc id == department_children
    // doc id). Any signed-in user may read it so the team-member picker in every
    // department can offer children by name; the full child record (DOB, parents)
    // stays gated by the department_children rule above. Only River Kids writers
    // maintain it.
    match /river_kids_lookup/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('River Kids'));
    }

    match /department_events/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    // Event spending table for Event Management → Spending (read/write to authorized department users)
    match /event_spending/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_planning_notes/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_updates/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /department_entries/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /delight_visitors/{docId} {
      // Read opened to ANY signed-in user (was an allow-list of D Light / Caring /
      // Sunday Ministry / Cell / Worship).
      //
      // Most people in the church only ever exist as a D Light Visitor Entry record —
      // they have no `people` doc, no PCS entry, no cell membership yet. That makes this
      // collection the single largest source feeding getMergedPeopleDirectory(), which is
      // the roster behind every "search the People's Directory" picker in the app.
      //
      // The allow-list meant a Director in any OTHER department (Media, Finance,
      // Administration, River Kids, Sec-Core, …) got permission-denied on the whole
      // getDelightVisitors() query. Because the caller wraps it in `.catch(() => [])`,
      // there was no error anywhere — the visitor-entry people just silently didn't
      // exist in search, so those Directors could not find anyone to add to their team.
      // That is the bug this rule change fixes.
      //
      // Every signed-in account is a church leader who was deliberately granted app
      // access, so read here is intentionally not department-scoped. Write authority is
      // unchanged: only D Light creates/deletes, only D Light and Caring update.
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('D Light') || canAccessDept('Caring'));
    }

    match /dlight_sub_departments/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
    }

    match /dlight_members/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || getUserRole() == 'Admin' || canAccessDept('D Light'));
    }

    match /sunday_program/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    match /sunday_program_log/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    match /cell_groups/{cellId} {
      // Sunday Ministry and Caring need read access (attendance + PCS cell connections).
      // D-Light needs read access too: the cell-assignment-consult reply modal lets the
      // D-Light Director pick a recommended cell group by name. Worship needs it too:
      // the Worship Ministry Application Form's "Which Cell Group do you belong to?"
      // dropdown (WorshipApplications.jsx) queries this collection directly — without
      // this, the query silently permission-denies for anyone without Cell/Sunday
      // Ministry/Caring/D Light access, and the swallowed catch left the dropdown
      // showing only its empty placeholder with no visible error.
      //
      // Now opened to any signed-in user rather than growing that list a department at
      // a time: getMergedPeopleDirectory() reads this to label which cell group each
      // person belongs to, so a denial here degraded the shared people search for every
      // department not named above. A cell group's name/leader is not sensitive.
      // Create/update/delete remain Cell-scoped.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || isCellDirector());
      // isCellDirector() added to match the members subcollection below — some Cell
      // Directors are set up via positions[] only (no top-level department/departments
      // field), so canAccessDept('Cell') alone was rejecting the memberCount bump that
      // addCellGroupMember() does right after creating the member doc, leaving a
      // half-written assignment (member added, count stale) with a swallowed error.
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || isCellDirector());
    }

    match /cell_groups/{cellId}/members/{memberId} {
      // Read opened to any signed-in user. getMergedPeopleDirectory() reads this via a
      // collectionGroup('members') query, which fails ENTIRELY (not per-document) if the
      // requester isn't allowed here — silently dropping every cell member from the
      // shared people search for any department outside the old allow-list. Must stay in
      // sync with the /{path=**}/members/{memberId} collection-group rule at the bottom
      // of this file; a collection-group query is checked against that rule, this one
      // covers direct per-cell reads. Writes stay tightly scoped below.
      allow read: if isSignedIn();
      // Write is restricted: Founder/Admin full access; Cell Director can write any cell;
      // Cell Leader can only write members within their own linked cell.
      allow create, update, delete: if isSignedIn() && (
        isFullAccess() ||
        isCellDirector() ||
        (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId))
      );
    }
    match /cell_groups/{cellId}/program_items/{itemId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
      allow create, update, delete: if isSignedIn() && (isFullAccess() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
    }
    // Cell Director's "dismiss" on a Sunday-attendance-derived Unassigned card — these
    // people have no task/member doc of their own (they're just a name diffed out of
    // Sunday attendance vs. cell rosters), so dismissal needs its own small durable
    // record or it silently only lived in React state and reappeared on reload.
    // Doc id is the normalized lowercase name; shared across all Cell Directors on
    // purpose (a dismissal by one director should stick for everyone, same as an
    // actual assignment would).
    match /cell_unassigned_dismissals/{nameKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || isCellDirector());
    }

    match /cell_program_log/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cell_back_to_bible/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cell_member_pending_changes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Prefer cellGroupId when set; otherwise cellId (leader's linked cell for report edits).
    function userLinkedCellId() {
      let d = getUserData();
      let g = d.get('cellGroupId', null);
      return g != null && g != '' ? g : d.get('cellId', null);
    }
    // True when the given cell_groups Firestore doc ID matches the user's linked cell.
    // Handles two cases:
    //  1. Profile stores the doc ID directly - exact match.
    //  2. Profile stores a logical cellId string (e.g. "bethany") - look up the
    //     cell_groups doc and compare its cellId field against the profile value.
    function userLinkedCellMatchesDocId(docId) {
      let linked = userLinkedCellId();
      return linked != null && linked != '' && (
        linked == docId ||
        (exists(/databases/$(database)/documents/cell_groups/$(docId)) &&
         get(/databases/$(database)/documents/cell_groups/$(docId)).data.get('cellId', '') == linked)
      );
    }
    // True when the user's `positions` array has an explicit Cell-department Director
    // entry (new `role: 'DIRECTOR'` schema or legacy `position: 'Director'` schema).
    function hasCellDirectorPosition() {
      return isSignedIn() && getUserData().get('positions', []).hasAny([
        {'department': 'Cell', 'role': 'DIRECTOR'},
        {'department': 'Cell', 'position': 'Director'}
      ]);
    }
    // True when `positions` has ANY entry for the Cell department, regardless of role
    // (Director/Coordinator/Cell Leader/Associate — the AdminUserManagement dropdown
    // options — plus the new-schema role tokens). Rules language has no generic
    // "any element has field X" check, so this enumerates every position value the
    // app actually writes (see AdminUserManagement.jsx's position dropdown).
    function hasAnyCellPosition() {
      return isSignedIn() && getUserData().get('positions', []).hasAny([
        {'department': 'Cell', 'position': 'Director'},
        {'department': 'Cell', 'position': 'Coordinator'},
        {'department': 'Cell', 'position': 'Cell Leader'},
        {'department': 'Cell', 'position': 'Associate'},
        {'department': 'Cell', 'role': 'DIRECTOR'},
        {'department': 'Cell', 'role': 'COORDINATOR'},
        {'department': 'Cell', 'role': 'LEADER'},
        {'department': 'Cell', 'role': 'MEMBER'}
      ]);
    }
    // Mirrors the client's getDepartmentRole() in src/utils/access.js, which only
    // consults the top-level role/department fields when no Cell entry exists.
    function hasNoCellPosition() {
      return !hasAnyCellPosition();
    }
    function isCellDirector() {
      // Prefer the explicit positions-array check above. Only fall back to the
      // top-level role/department fields when `positions` has no Cell entry at
      // all — matching src/utils/access.js's getDepartmentRole() exactly, so a
      // Director whose `positions` array only lists other departments (e.g. also
      // River Kids Director) but whose legacy top-level department/role fields
      // say Cell Director still gets recognized here the same way the client
      // already recognizes them (previously this only fired when `positions`
      // was entirely empty, which silently denied reads the UI had already
      // allowed for any Director with a non-empty positions array and no
      // explicit Cell entry).
      return isSignedIn() && (
        hasCellDirectorPosition() ||
        (hasNoCellPosition() &&
          getUserRole() == 'Director' &&
          (userDepartment() == 'Cell' || 'Cell' in userDepartments()))
      );
    }
    match /cell_reports/{reportId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow create: if isSignedIn() && (isFullAccess() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(request.resource.data.cellId)));
      allow update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }
    match /cell_reports/{reportId}/attendees/{attendeeId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(get(/databases/$(database)/documents/cell_reports/$(reportId)).data.get('cellId', ''))));
      allow create, update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(get(/databases/$(database)/documents/cell_reports/$(reportId)).data.get('cellId', ''))));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    // Weekly cell report history
    match /cell_report_history/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(resource.data.cellId)));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    match /caring_members/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    match /caring_pcs/{docId} {
      // Read opened to any signed-in user (was Caring-only) — getMergedPeopleDirectory()
      // is the "everybody in the church's records" directory used by pickers across every
      // department (e.g. Sec-Core's Director Board "Add Person"), so a PCS-only person was
      // otherwise silently unfindable outside Caring. Write stays Caring-gated.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    // Central people registry — Caring is the primary gatekeeper; other depts read for search/linking
    match /people/{personId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('D Light') || isCellDirector());
    }

    // Lightweight PCS membership lookup — any signed-in user can read, Caring writes
    match /pcs_lookup/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    // PCS add notifications: Cell Leader sends → Caring Director receives
    match /pcs_add_notifications/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Visitor proposals: Cell/Caring propose → D-Light Director reviews
    match /cell_visitor_proposals/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Caring'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('D Light') || canAccessDept('Cell') || canAccessDept('Caring'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('D Light'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // PCS profile-fill invitations: Caring Director sends → Cell Leader fills
    match /pcs_fill_invitations/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
      allow read:   if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow update: if isSignedIn() && (isFullAccess() || canAccessDept('Caring') || canAccessDept('Cell'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Caring'));
    }

    // In-app "Remind" notifications: Cell/Caring director sends → Cell Leader sees it on
    // their own MyFellowship view and dismisses it (marks status 'read').
    match /cell_report_reminders/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Caring'));
      allow read, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell') || canAccessDept('Caring'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Cell Leader sends a note about a member → Cell Director sees it in Shepherd's Hub
    // and marks it read once addressed.
    match /cell_leader_director_notes/{docId} {
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow read, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    match /cell_attendance/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || canAccessDept(resource.data.department));
    }

    match /finance_budget/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || !('department' in resource.data) || canAccessDept(resource.data.department));
      allow create: if isSignedIn() && (isFullAccess() || !('department' in request.resource.data) || canAccessDept(request.resource.data.department));
      allow update, delete: if isSignedIn() && (isFullAccess() || !('department' in resource.data) || canAccessDept(resource.data.department));
    }

    match /pastor_department_remarks/{docId} {
      allow read, write: if isSignedIn();
    }

    match /pastor_department_updates/{docId} {
      allow read, write: if isSignedIn();
    }

    match /finance_income/{docId} {
      allow read, write: if isSignedIn();
    }

    match /finance_expense/{docId} {
      allow read, write: if isSignedIn();
    }

    match /finance_savings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /expense_departments/{docId} {
      allow read, write: if isSignedIn();
    }

    match /attendance/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_plans/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_budget_items/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_team_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_songs/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_schedule/{docId} {
      allow read, write: if isSignedIn();
    }

    // Media department's per-Sunday crew assignments (Assign tab). Department-
    // scoped, unlike worship_schedule above — this replaces the department-scoped
    // department_assignments/media doc.
    match /media_schedule/{docId} {
      allow read, write: if isSignedIn() && (isFullAccess() || canAccessDept('Media'));
    }

    // Auto-created/updated by saveAssignPlan (DepartmentWorship.jsx) right after the
    // schedule write, and by the Practice & Rehearsals tab — without this rule the
    // collection has no explicit match, so Firestore denies by default and every
    // "Save plan" throws on this step even though the schedule itself already saved.
    match /worship_rehearsals/{docId} {
      allow read, write: if isSignedIn();
    }

    match /worship_applications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_ministry_team_members/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_ministry_budget_items/{docId} {
      allow read, write: if isSignedIn();
    }

    match /sunday_reports/{docId} {
      allow read: if isSignedIn();
      // D Light additionally writes second/third/fourth week comer names onto the report
      // for a given Sunday (Follow-Up panel on the Visitors page) — same cross-department
      // write pattern already used by River Kids for the riverKids field. River Kids
      // itself was missing from this list despite the comment above referencing it as
      // precedent — every attendance toggle in River Kids' Attendance tab calls
      // patchSundayReportRiverKids(), which was permission-denied for a River Kids
      // account, surfacing as a generic "Failed to save" alert with no detail.
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() || canAccessDept('D Light') || canAccessDept('River Kids'));
    }

    // Per-person Sunday attendance (recordPersonSundayAttendance) — written alongside
    // sunday_reports whenever a Non Cell/Others attendee is linked to a real People
    // Directory or D-Light visitor record, so their own profile (e.g. a Caring PCS
    // entry's "consecutive Sundays absent" badge) can be matched by real visitorId/
    // personId instead of name string alone. Had no rule at all before this — every
    // write from SundayReport.jsx was silently failing (swallowed by .catch(() => {})),
    // so the collection was effectively always empty. Same writer set as sunday_reports
    // itself; read is open like sunday_reports since Caring/People Directory both need
    // to read it regardless of department.
    match /person_sunday_attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() || canAccessDept('D Light') || canAccessDept('River Kids'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Mid-week Ministry: prayer points per cell per date
    match /cell_midweek_prayer/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Mid-week Ministry: segment order settings per cell group
    match /cell_midweek_settings/{cellId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || isCellDirector() || (canAccessDept('Cell') && userLinkedCellMatchesDocId(cellId)));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Mid-week session summaries: timings, shepherd notes, attendee IDs per session
    match /cell_midweek_sessions/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Cell'));
      allow delete: if isSignedIn() && (isFullAccess() || isCellDirector());
    }

    // Sunday service attendance (cell-level bubble grid)
    match /sunday_service_attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || canAccessDept('Cell'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Sunday Plan checklists — defaults (Directors set once)
    match /sunday_checklist_defaults/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
    }

    match /board_meeting_points/{docId} {
      allow read: if isSignedIn();
      // Sec-Core manages the whole board agenda across every department (accepting,
      // scheduling, staging for presentation), not just points its own account
      // happens to have department access to — same "Sec-Core gets blanket access"
      // pattern as sec_core_board_meetings below. A department also keeps managing
      // its own submitted points via the existing per-point-department check.
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core') || canAccessDept(resource.data.department));
      // Submitting a discussion point is a self-service action, open to any signed-in
      // account — NOT gated on canAccessDept(department). A Director Board roster
      // member's represented department (set by whoever added them to the roster —
      // see sec_core/director_board below) doesn't necessarily match their own
      // account's own department access (e.g. a Worship team member with no
      // account-level Worship position, representing Worship on the board), so the
      // previous canAccessDept(request.resource.data.department) check rejected
      // every such submission with "Missing or insufficient permissions." Submitting
      // isn't privileged — createdBy records who submitted it, and Sec-Core reviews/
      // triages every point regardless of department before it's acted on. Editing or
      // deleting an existing point still goes through the restricted `write` rule above.
      allow create: if isSignedIn();
    }

    // Director Board roster — readable by any signed-in user, not just Sec-Core.
    // BoardMeetingWorkspaceWidget/WorkspaceHeader read this doc for every signed-in
    // account (not only Sec-Core ones) to work out whether *they* sit on the Director
    // Board roster and, if so, which department they represent there — same "read
    // open" philosophy already used for the sibling sec_core_board_meetings and
    // board_meeting_points collections below, for the same reason (roster/meeting
    // membership spans many departments, not just Sec-Core). Without this, a
    // non-Sec-Core roster member's own client can't even read their roster entry,
    // so the invite banner silently never renders for them. Only Sec-Core edits the
    // roster itself, so write stays restricted. Must precede the generic
    // /sec_core/{docId} block below (which stays locked down) since Firestore grants
    // access to a path if ANY matching rule allows it.
    match /sec_core/director_board {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    match /sec_core/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    match /sec_core_sunday_leader/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    match /sec_core_leader_assignment_notifications/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    // Scheduled Director Board meetings — read open like board_meeting_points since
    // Director Board members are leaders from many departments, not necessarily
    // Sec-Core itself, and need to read meeting details from their own notification/
    // workspace widget. Only Sec-Core schedules meetings, so write stays restricted.
    match /sec_core_board_meetings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    match /sec_core_board_meeting_notifications/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || resource.data.uid == request.auth.uid || canAccessDept('Sec-Core'));
      allow write: if isSignedIn() && (isFullAccess() || canAccessDept('Sec-Core'));
    }

    // Sunday Plan checklists — weekly instances
    match /sunday_checklist_weekly/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
      allow delete: if isSignedIn() && isFullAccess();
    }

    // Sunday programme notifications (Sunday Ministry → departments)
    match /sunday_notifications/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector());
    }

    // Department programme inputs (each dept's elements per Sunday)
    match /sunday_dept_inputs/{docId} {
      allow read: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() ||
        canAccessDept('Media') || canAccessDept('Worship') || canAccessDept('D Light') || canAccessDept('Administration'));
      allow create, update: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry') || isCellDirector() ||
        canAccessDept('Media') || canAccessDept('Worship') || canAccessDept('D Light') || canAccessDept('Administration'));
      allow delete: if isSignedIn() && (isFullAccess() || canAccessDept('Sunday Ministry'));
    }

    // RFF (school program) — deliberately gated the same way any other
    // department-scoped collection is. RFF is intentionally absent from the
    // app's regular department roster (see
    // docs/superpowers/specs/2026-08-26-rff-department-design.md), so this
    // rule is what actually keeps its data private at the database level —
    // canAccessDept('RFF') is only true for the Founder (isFullAccess()) or a
    // user holding an explicit RFF position.
    match /rff_programs/{docId} {
      allow read, write: if isSignedIn() && canAccessDept('RFF');
    }
    match /rff_students/{docId} {
      allow read, write: if isSignedIn() && canAccessDept('RFF');
    }

    // Founder File Manager (office file registry) — see
    // docs/superpowers/specs/2026-08-26-file-manager-design.md. Founder-only,
    // same tier as worklist_sheets.
    match /project_files/{docId} {
      allow read, write: if isFullAccess();
    }

    // Collection-group query support: allows collectionGroup(db, 'members') used by
    // getAllCellGroupMembers(), which every "search the People's Directory" picker
    // depends on via getMergedPeopleDirectory().
    //
    // Opened to any signed-in user (was Cell / Sunday Ministry / Caring / Worship).
    // A collection-group query is all-or-nothing against this single rule, so any
    // department outside that list lost every cell member from people search at once.
    // Keep this in agreement with /cell_groups/{cellId}/members/{memberId} above.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
    }
  }
}
