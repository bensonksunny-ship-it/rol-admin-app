rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Member profile photos — Caring Director and Founder can write; any signed-in user can read
    match /member_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.globalRole == 'FOUNDER' ||
        request.resource.size < 5 * 1024 * 1024 &&  // max 5 MB
        request.resource.contentType.matches('image/.*')
      );
    }
    // Media → Upcoming Sunday: audio attached to a programme element (backing track,
    // sound effect). The public Control Center plays it through the download URL's
    // token, so reads here are only for signed-in users.
    match /media_audio/{sundayDate}/{fileName} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
