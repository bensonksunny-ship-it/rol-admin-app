# Firebase - copy to .env and fill with your Firebase project config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# RFF pages: set to "external" to show data from the standalone RFF app
# (read-only, via the getRFFData Cloud Function). Leave blank to use this
# project's own rff_programs / rff_students. Setup: docs/rff-external-sync.md
VITE_RFF_SOURCE=
